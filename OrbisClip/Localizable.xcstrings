    "Testo formattato: si incolla con la sua formattazione.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatted text: pastes with its formatting."
          }
        }
      }
    },
    "Tieni premuti i tasti e fai clic: %@. Clicca il campo e premi la combinazione; Esc annulla, ⌫ ripristina ⇧.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the keys and click: %@. Click the field and press the shortcut; Esc cancels, ⌫ resets to ⇧."
          }
        }
      }
    },
